    /** Small JSON reader/writer so this source file has no JSON dependency. */
    private static final class Json {
        private final String source;
        private int index;

        private Json(final String source) {
            this.source = source;
        }

        static Object parse(final String source) throws IOException {
            final Json parser = new Json(source);
            final Object value = parser.value();
            parser.space();
            if (parser.index != source.length()) {
                throw new IOException("Unexpected data after JSON at offset " + parser.index);
            }
            return value;
        }

        static String write(final Object value) {
            final StringBuilder out = new StringBuilder();
            writeValue(value, out);
            return out.toString();
        }

        private static void writeValue(final Object value, final StringBuilder out) {
            if (value == null) {
                out.append("null");
            } else if (value instanceof String) {
                quote((String) value, out);
            } else if (value instanceof Number || value instanceof Boolean) {
                out.append(value);
            } else if (value instanceof Map) {
                out.append('{');
                boolean first = true;
                for (final Map.Entry<?, ?> entry : ((Map<?, ?>) value).entrySet()) {
                    if (!first) {
                        out.append(',');
                    }
                    first = false;
                    quote(String.valueOf(entry.getKey()), out);
                    out.append(':');
                    writeValue(entry.getValue(), out);
                }
                out.append('}');
            } else if (value instanceof List) {
                out.append('[');
                boolean first = true;
                for (final Object item : (List<?>) value) {
                    if (!first) {
                        out.append(',');
                    }
                    first = false;
                    writeValue(item, out);
                }
                out.append(']');
            } else {
                quote(String.valueOf(value), out);
            }
        }

        private static void quote(final String value, final StringBuilder out) {
            out.append('"');
            for (int i = 0; i < value.length(); i++) {
                final char c = value.charAt(i);
                switch (c) {
                    case '"': out.append("\\\""); break;
                    case '\\': out.append("\\\\"); break;
                    case '\b': out.append("\\b"); break;
                    case '\f': out.append("\\f"); break;
                    case '\n': out.append("\\n"); break;
                    case '\r': out.append("\\r"); break;
                    case '\t': out.append("\\t"); break;
                    default:
                        if (c < 0x20) {
                            out.append(String.format("\\u%04x", (int) c));
                        } else {
                            out.append(c);
                        }
                }
            }
            out.append('"');
        }

        private Object value() throws IOException {
            space();
            if (index >= source.length()) {
                throw error("Unexpected end of JSON");
            }
            final char c = source.charAt(index);
            if (c == '{') return objectValue();
            if (c == '[') return arrayValue();
            if (c == '"') return stringValue();
            if (c == 't') return literal("true", Boolean.TRUE);
            if (c == 'f') return literal("false", Boolean.FALSE);
            if (c == 'n') return literal("null", null);
            return numberValue();
        }

        private Map<String, Object> objectValue() throws IOException {
            index++;
            final Map<String, Object> result = new LinkedHashMap<>();
            space();
            if (consume('}')) return result;
            while (true) {
                space();
                if (index >= source.length() || source.charAt(index) != '"') {
                    throw error("Expected object key");
                }
                final String key = stringValue();
                space();
                if (!consume(':')) throw error("Expected ':'");
                result.put(key, value());
                space();
                if (consume('}')) return result;
                if (!consume(',')) throw error("Expected ',' or '}'");
            }
        }

        private List<Object> arrayValue() throws IOException {
            index++;
            final List<Object> result = new ArrayList<>();
            space();
            if (consume(']')) return result;
            while (true) {
                result.add(value());
                space();
                if (consume(']')) return result;
                if (!consume(',')) throw error("Expected ',' or ']'");
            }
        }

        private String stringValue() throws IOException {
            if (!consume('"')) throw error("Expected string");
            final StringBuilder result = new StringBuilder();
            while (index < source.length()) {
                final char c = source.charAt(index++);
                if (c == '"') return result.toString();
                if (c != '\\') {
                    result.append(c);
                    continue;
                }
                if (index >= source.length()) throw error("Bad escape");
                final char escaped = source.charAt(index++);
                switch (escaped) {
                    case '"': result.append('"'); break;
                    case '\\': result.append('\\'); break;
                    case '/': result.append('/'); break;
                    case 'b': result.append('\b'); break;
                    case 'f': result.append('\f'); break;
                    case 'n': result.append('\n'); break;
                    case 'r': result.append('\r'); break;
                    case 't': result.append('\t'); break;
                    case 'u':
                        if (index + 4 > source.length()) throw error("Bad unicode escape");
                        try {
                            result.append((char) Integer.parseInt(source.substring(index, index + 4), 16));
                        } catch (final NumberFormatException e) {
                            throw error("Bad unicode escape");
                        }
                        index += 4;
                        break;
                    default: throw error("Unknown escape");
                }
            }
            throw error("Unterminated string");
        }

        private Object numberValue() throws IOException {
            final int start = index;
            if (consume('-')) { /* sign */ }
            while (index < source.length() && Character.isDigit(source.charAt(index))) index++;
            if (consume('.')) {
                while (index < source.length() && Character.isDigit(source.charAt(index))) index++;
            }
            if (index < source.length() && (source.charAt(index) == 'e'
                    || source.charAt(index) == 'E')) {
                index++;
                if (index < source.length() && (source.charAt(index) == '+'
                        || source.charAt(index) == '-')) index++;
                while (index < source.length() && Character.isDigit(source.charAt(index))) index++;
            }
            if (start == index) throw error("Expected value");
            final String raw = source.substring(start, index);
            try {
                if (!raw.contains(".") && !raw.contains("e") && !raw.contains("E")) {
                    return Long.parseLong(raw);
                }
                return Double.parseDouble(raw);
            } catch (final NumberFormatException e) {
                throw error("Invalid number");
            }
        }

        private Object literal(final String text, final Object value) throws IOException {
            if (!source.startsWith(text, index)) throw error("Invalid literal");
            index += text.length();
            return value;
        }

        private void space() {
            while (index < source.length() && Character.isWhitespace(source.charAt(index))) index++;
        }

        private boolean consume(final char expected) {
            if (index < source.length() && source.charAt(index) == expected) {
                index++;
                return true;
            }
            return false;
        }

        private IOException error(final String message) {
            return new IOException(message + " at offset " + index);
        }
    }
}
