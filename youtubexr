    private static CommentsPage getComments(final String videoId, final String continuation)
            throws IOException {
        final Map<String, Object> body;
        if (continuation == null) {
            body = map("context", Client.WEB.context(), "videoId", videoId);
        } else {
            body = map("context", Client.WEB.context(), "continuation", continuation);
        }
        final Map<String, Object> response = post("next", body, Client.WEB);
        if (continuation == null) {
            final String firstToken = findCommentsSectionToken(response);
            if (firstToken == null) {
                return new CommentsPage(Collections.emptyList(), null, -1);
            }
            return parseComments(post("next", map("context", Client.WEB.context(),
                    "continuation", firstToken), Client.WEB));
        }
        return parseComments(response);
    }

    private static CommentsPage parseComments(final Map<String, Object> response) {
        final List<Comment> comments = new ArrayList<>();
        final Set<String> seen = new HashSet<>();
        final Map<String, Map<String, Object>> payloads = new HashMap<>();
        collectCommentPayloads(response, payloads);
        collectModernComments(response, payloads, comments, seen);
        collectLegacyComments(response, comments, seen);
        final int count = findCommentCount(response);
        final String next = findContinuation(response);
        return new CommentsPage(comments, next, count);
    }

    private static void collectCommentPayloads(final Object value,
            final Map<String, Map<String, Object>> payloads) {
        if (value instanceof Map) {
            final Map<String, Object> current = object(value);
            if ("commentEntityPayload".equals(string(current.get("type")))) {
                // Current YouTube responses normally wrap this payload under "payload".
            }
            final Object mutationsObject = path(current, "frameworkUpdates", "entityBatchUpdate",
                    "mutations");
            for (final Object raw : array(mutationsObject)) {
                final Map<String, Object> mutation = object(raw);
                final Map<String, Object> payload = object(mutation.get("payload"));
                final Map<String, Object> entity = object(payload.get("commentEntityPayload"));
                if (!entity.isEmpty()) {
                    final String key = string(mutation.get("entityKey"));
                    if (key != null) {
                        payloads.put(key, entity);
                    }
                }
            }
            for (final Object child : current.values()) {
                collectCommentPayloads(child, payloads);
            }
        } else if (value instanceof List) {
            for (final Object child : array(value)) {
                collectCommentPayloads(child, payloads);
            }
        }
    }

    private static void collectModernComments(final Object value,
            final Map<String, Map<String, Object>> payloads,
            final List<Comment> comments, final Set<String> seen) {
        if (value instanceof Map) {
            final Map<String, Object> current = object(value);
            final Map<String, Object> view = object(current.get("commentViewModel"));
            if (!view.isEmpty()) {
                final String key = string(view.get("commentKey"));
                final Map<String, Object> entity = payloads.get(key);
                if (entity != null) {
                    final Map<String, Object> props = object(entity.get("properties"));
                    final Map<String, Object> author = object(entity.get("author"));
                    final Map<String, Object> toolbar = object(entity.get("toolbar"));
                    final Comment comment = new Comment();
                    comment.id = string(props.get("commentId"));
                    comment.text = string(path(props, "content", "content"));
                    comment.author = string(author.get("displayName"));
                    comment.authorChannelId = string(author.get("channelId"));
                    comment.authorAvatar = string(author.get("avatarThumbnailUrl"));
                    comment.published = string(props.get("publishedTime"));
                    comment.likeCount = string(toolbar.get("likeCountLiked"));
                    comment.replyCount = string(toolbar.get("replyCount"));
                    if (comment.id != null && seen.add(comment.id)) {
                        comments.add(comment);
                    }
                }
            }
            for (final Object child : current.values()) {
                collectModernComments(child, payloads, comments, seen);
            }
        } else if (value instanceof List) {
            for (final Object child : array(value)) {
                collectModernComments(child, payloads, comments, seen);
            }
        }
    }

    private static void collectLegacyComments(final Object value,
            final List<Comment> comments, final Set<String> seen) {
        if (value instanceof Map) {
            final Map<String, Object> current = object(value);
            final Map<String, Object> renderer = object(current.get("commentRenderer"));
            if (!renderer.isEmpty()) {
                final Comment comment = new Comment();
                comment.id = string(renderer.get("commentId"));
                comment.text = text(renderer.get("contentText"));
                comment.author = text(renderer.get("authorText"));
                comment.authorAvatar = string(path(renderer, "authorThumbnail", "thumbnails", "0",
                        "url"));
                comment.published = text(renderer.get("publishedTimeText"));
                comment.likeCount = text(renderer.get("voteCount"));
                comment.replyCount = text(renderer.get("replyCount"));
                if (comment.id != null && seen.add(comment.id)) {
                    comments.add(comment);
                }
            }
            for (final Object child : current.values()) {
                collectLegacyComments(child, comments, seen);
            }
        } else if (value instanceof List) {
            for (final Object child : array(value)) {
                collectLegacyComments(child, comments, seen);
            }
        }
    }

    private static String findCommentsSectionToken(final Object value) {
        if (value instanceof Map) {
            final Map<String, Object> current = object(value);
            if ("comments-section".equals(string(current.get("targetId")))) {
                final List<Object> contents = array(current.get("contents"));
                if (!contents.isEmpty()) {
                    final String token = string(path(contents.get(0), "continuationItemRenderer",
                            "continuationEndpoint", "continuationCommand", "token"));
                    if (token != null) {
                        return token;
                    }
                }
            }
            for (final Object child : current.values()) {
                final String found = findCommentsSectionToken(child);
                if (found != null) {
                    return found;
                }
            }
        } else if (value instanceof List) {
            for (final Object child : array(value)) {
                final String found = findCommentsSectionToken(child);
                if (found != null) {
                    return found;
                }
            }
        }
        return null;
    }

    private static String findContinuation(final Object value) {
        if (value instanceof Map) {
            final Map<String, Object> current = object(value);
            final String token = string(path(current, "continuationCommand", "token"));
            if (token != null) {
                return token;
            }
            for (final Object child : current.values()) {
                final String found = findContinuation(child);
                if (found != null) {
                    return found;
                }
            }
        } else if (value instanceof List) {
            for (final Object child : array(value)) {
                final String found = findContinuation(child);
                if (found != null) {
                    return found;
                }
            }
        }
        return null;
    }

    private static int findCommentCount(final Object value) {
        if (value instanceof Map) {
            final Map<String, Object> current = object(value);
            final Map<String, Object> header = object(current.get("commentsHeaderRenderer"));
            if (!header.isEmpty()) {
                final String raw = text(header.get("countText"));
                if (raw != null) {
                    final String digits = raw.replaceAll("[^0-9]", "");
                    try {
                        return Integer.parseInt(digits);
                    } catch (final NumberFormatException ignored) {
                        return -1;
                    }
                }
            }
            for (final Object child : current.values()) {
                final int found = findCommentCount(child);
                if (found >= 0) {
                    return found;
                }
            }
        } else if (value instanceof List) {
            for (final Object child : array(value)) {
                final int found = findCommentCount(child);
                if (found >= 0) {
                    return found;
                }
            }
        }
        return -1;
    }

    private static Map<String, Object> post(final String endpoint,
            final Map<String, Object> body, final Client client) throws IOException {
        return postToUrl(API + endpoint + "?prettyPrint=false", body, client);
    }

    private static Map<String, Object> postToUrl(final String target,
            final Map<String, Object> body, final Client client) throws IOException {
        final HttpURLConnection connection = (HttpURLConnection) new URL(target).openConnection();
        connection.setRequestMethod("POST");
        connection.setConnectTimeout(20_000);
        connection.setReadTimeout(30_000);
        connection.setDoOutput(true);
        connection.setRequestProperty("Content-Type", "application/json; charset=UTF-8");
        connection.setRequestProperty("Accept", "application/json");
        connection.setRequestProperty("User-Agent", client.userAgent);
        if (client == Client.VISIONOS) {
            connection.setRequestProperty("X-Goog-Api-Format-Version", "2");
        } else {
            connection.setRequestProperty("X-YouTube-Client-Name", client.id);
            connection.setRequestProperty("X-YouTube-Client-Version", client.version);
        }
        final byte[] request = Json.write(body).getBytes(StandardCharsets.UTF_8);
        connection.setFixedLengthStreamingMode(request.length);
        try (OutputStream output = connection.getOutputStream()) {
            output.write(request);
        }
        try {
            final int status = connection.getResponseCode();
            final InputStream input = status >= 400
                    ? connection.getErrorStream() : connection.getInputStream();
            final String response = input == null ? "" : readUtf8(input);
            if (status < 200 || status >= 300) {
                throw new IOException("YouTube " + target + " returned HTTP " + status
                        + ": " + response.substring(0, Math.min(response.length(), 400)));
            }
            final Object parsed = Json.parse(response);
            return object(parsed);
        } finally {
            connection.disconnect();
        }
    }

    private static String readUtf8(final InputStream input) throws IOException {
        try (InputStream in = input; ByteArrayOutputStream out = new ByteArrayOutputStream()) {
            final byte[] buffer = new byte[8192];
            int read;
            while ((read = in.read(buffer)) != -1) {
                out.write(buffer, 0, read);
                if (out.size() > 25_000_000) {
                    throw new IOException("YouTube response exceeded 25 MB");
                }
            }
            return new String(out.toByteArray(), StandardCharsets.UTF_8);
        }
    }

