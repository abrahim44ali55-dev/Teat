    private static String videoIdFrom(final String input) {
        if (input == null || input.trim().isEmpty()) {
            throw new IllegalArgumentException("YouTube URL or video ID is required");
        }
        final String value = input.trim();
        if (value.matches("[A-Za-z0-9_-]{11}")) {
            return value;
        }
        try {
            final URL url = new URL(value.startsWith("http") ? value : "https://" + value);
            final String host = url.getHost().toLowerCase();
            if (host.equals("youtu.be") || host.endsWith(".youtu.be")) {
                final String path = url.getPath().replaceFirst("^/", "");
                if (path.matches("[A-Za-z0-9_-]{11}.*")) {
                    return path.substring(0, 11);
                }
            }
            final String query = url.getQuery();
            if (query != null) {
                for (final String pair : query.split("&")) {
                    final String[] kv = pair.split("=", 2);
                    if (kv.length == 2 && "v".equals(kv[0])
                            && kv[1].matches("[A-Za-z0-9_-]{11}")) {
                        return kv[1];
                    }
                }
            }
            final String[] parts = url.getPath().split("/");
            for (int i = parts.length - 1; i >= 0; i--) {
                if (parts[i].matches("[A-Za-z0-9_-]{11}")) {
                    return parts[i];
                }
            }
        } catch (final Exception e) {
            throw new IllegalArgumentException("Could not read YouTube video ID", e);
        }
        throw new IllegalArgumentException("URL does not contain a valid YouTube video ID");
    }

    private static String appendQuery(final String url, final String key, final String value) {
        final String separator = url.contains("?") ? "&" : "?";
        try {
            return url + separator + URLEncoder.encode(key, "UTF-8") + "="
                    + URLEncoder.encode(value, "UTF-8");
        } catch (final Exception e) {
            return url;
        }
    }

    private static Map<String, String> parseQuery(final String query) {
        if (query == null || query.isEmpty()) {
            return Collections.emptyMap();
        }
        final Map<String, String> result = new LinkedHashMap<>();
        for (final String pair : query.split("&")) {
            final String[] kv = pair.split("=", 2);
            if (kv.length == 2) {
                result.put(urlDecode(kv[0]), urlDecode(kv[1]));
            }
        }
        return result;
    }

    private static String urlDecode(final String value) {
        try {
            return java.net.URLDecoder.decode(value, "UTF-8");
        } catch (final Exception e) {
            return value;
        }
    }

    private static void addUnique(final List<?> list, final Object item, final String key) {
        for (final Object old : list) {
            final String oldKey;
            if (old instanceof MediaLink) {
                oldKey = ((MediaLink) old).url;
            } else if (old instanceof Subtitle) {
                oldKey = ((Subtitle) old).url;
            } else if (old instanceof Thumbnail) {
                oldKey = ((Thumbnail) old).url;
            } else {
                oldKey = null;
            }
            if (key != null && key.equals(oldKey)) {
                return;
            }
        }
        @SuppressWarnings("unchecked")
        final List<Object> writable = (List<Object>) list;
        writable.add(item);
    }

    private static Map<String, Object> map(final Object... pairs) {
        final Map<String, Object> result = new LinkedHashMap<>();
        for (int i = 0; i + 1 < pairs.length; i += 2) {
            result.put(String.valueOf(pairs[i]), pairs[i + 1]);
        }
        return result;
    }

